---
import Base from '../layouts/Base.astro';
---
<Base lang="en" title="Page not found · flightwake" description="Return to the flightwake home page." path="/404">
  <main class="missing"><p>404 / LOST SIGNAL</p><h1>This trail does not exist yet.</h1><a href="/">Back to the home page ↗</a></main>
</Base>
<style>.missing{min-height:75vh;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;gap:1rem;padding:2rem;background:#f6f2e9;color:#252722;font-family:system-ui,sans-serif}.missing p{letter-spacing:.15em;color:#e16843}.missing h1{font-size:clamp(2rem,6vw,4rem)}.missing a{color:inherit}</style>
