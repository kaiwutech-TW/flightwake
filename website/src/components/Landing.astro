---
import Base from '../layouts/Base.astro';
import { localized, type Language } from '../content';
import { modCaptures, modCommands } from '../modCaptures';
import '../styles/site.css';
interface Props { lang: Language }
const { lang } = Astro.props;
const c = localized[lang];
const path = { 'zh-TW': '/', 'zh-CN': '/zh-CN/', en: '/en/', ja: '/ja/' }[lang];
const languageNames = { 'zh-TW': '繁體中文', 'zh-CN': '简体中文', en: 'English', ja: '日本語' } as const;
const languagePaths = { 'zh-TW': '/', 'zh-CN': '/zh-CN/', en: '/en/', ja: '/ja/' } as const;
const installLanguage = lang === 'zh-CN' ? 'zh-CN' : lang === 'ja' ? 'ja' : lang === 'en' ? 'en' : 'zh-TW';
const installCommand = `npx flightwake init --lang=${installLanguage} --agents=claude,codex,gemini`;
const readme = { 'zh-TW': 'README.zh-TW.md', 'zh-CN': 'README.zh-CN.md', en: 'README.md', ja: 'README.ja.md' }[lang];
const modDoc = { 'zh-TW': 'docs/mod.zh-TW.md', 'zh-CN': 'docs/mod.zh-CN.md', en: 'docs/mod.md', ja: 'docs/mod.ja.md' }[lang];
const repo = 'https://github.com/kaiwutech-TW/flightwake';
const anchors = ['idea', 'workflow', 'mod', 'orca', 'features', 'install', 'faq'];
---
<Base lang={lang} title={c.title} description={c.description} path={path} faqs={[...c.faqs]}>
  <a class="skip" href="#main">{{ 'zh-TW': '跳到主要內容', 'zh-CN': '跳到主要内容', en: 'Skip to content', ja: '本文へ移動' }[lang]}</a>
  <header class="site-header"><div class="wrap header-inner">
    <a class="brand" href={path} aria-label="flightwake home"><img class="brand-mark" src="/favicon.svg" width="36" height="36" alt="" /><span>flightwake</span><span class="brand-dot">.</span></a>
    <nav class="desktop-nav" aria-label={{ 'zh-TW': '主要導覽', 'zh-CN': '主要导航', en: 'Main navigation', ja: 'メインナビゲーション' }[lang]}>{c.nav.map((label, i) => <a href={`#${anchors[i]}`}>{label}</a>)}</nav>
    <div class="header-actions"><details class="language-menu"><summary aria-label={lang === 'ja' ? '言語を選択' : lang === 'en' ? 'Choose language' : '選擇語言'}>{languageNames[lang]} <span aria-hidden="true">⌄</span></summary><div class="language-options">{(Object.keys(languageNames) as Language[]).map((code) => <a href={languagePaths[code]} lang={code} data-language-choice={code} aria-current={code === lang ? 'page' : undefined}>{languageNames[code]}</a>)}</div></details><a class="github" href={repo} target="_blank" rel="noopener noreferrer" aria-label="GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .9A11.1 11.1 0 0 0 .9 12a11.1 11.1 0 0 0 7.59 10.53c.56.1.76-.24.76-.54v-2.13c-3.09.67-3.74-1.31-3.74-1.31-.5-1.27-1.23-1.61-1.23-1.61-1-.69.08-.67.08-.67 1.11.08 1.69 1.14 1.69 1.14.99 1.69 2.6 1.2 3.23.92.1-.72.39-1.2.7-1.48-2.47-.28-5.07-1.24-5.07-5.49 0-1.21.43-2.2 1.14-2.98.12-.28-.5-1.42.11-2.95 0 0 .93-.3 3.05 1.14A10.6 10.6 0 0 1 12 6.65c.94 0 1.87.13 2.75.37 2.12-1.44 3.05-1.14 3.05-1.14.61 1.53.23 2.67.11 2.95.71.78 1.14 1.77 1.14 2.98 0 4.26-2.6 5.2-5.08 5.48.4.34.75 1.01.75 2.04v2.66c0 .3.2.65.77.54A11.1 11.1 0 0 0 23.1 12 11.1 11.1 0 0 0 12 .9Z"/></svg></a></div>
  </div></header>
  <main id="main">
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-copy"><p class="eyebrow"><span class="pulse-dot" aria-hidden="true"></span>{c.eyebrow}</p><h1 id="hero-title">{c.heroA}<br /><em>{c.heroB}</em></h1><p class="hero-description">{c.heroText}</p><div class="hero-buttons"><a class="button button-dark" href="#install">{c.heroCta}<span aria-hidden="true">↗</span></a><a class="text-link" href="#workflow">{c.heroGhost}<span aria-hidden="true">↓</span></a></div><div class="release-line"><span class="release-current">{c.latest}</span><span class="release-separator" aria-hidden="true">/</span><span>{c.next}</span></div></div>
      <div class="hero-art" role="img" aria-label={c.heroLabel}><div class="orbit orbit-a"></div><div class="orbit orbit-b"></div><div class="orbit orbit-c"></div><div class="art-badge art-badge-top"><span class="badge-signal"></span> SESSION 01 → 02 → 03</div><div class="terminal"><div class="terminal-head"><span class="terminal-lights" aria-hidden="true"><i></i><i></i><i></i></span><span>{c.terminalTitle}</span><span>↗</span></div><div class="terminal-body">{c.terminalLines.map((line, i) => <div class:list={['terminal-row', { muted: i % 2 === 1, highlight: i === 5 }]}><span class="terminal-caret" aria-hidden="true">{i % 2 === 0 ? '›' : '·'}</span><span>{line}</span></div>)}</div></div><div class="art-badge art-badge-bottom"><span>●</span><span>STATE.md</span><span class="badge-line"></span><span>READY</span></div><svg class="flight-path" viewBox="0 0 450 500" preserveAspectRatio="none" aria-hidden="true"><path d="M20 460 C90 370 60 240 185 198 S330 160 420 38" fill="none" stroke="#ed693e" stroke-width="2" stroke-linecap="round" stroke-dasharray="4 9"/><circle cx="420" cy="38" r="7" fill="#ed693e"/></svg></div>
    </section>
    <div class="marquee" aria-hidden="true"><div class="marquee-track"><span>CONTEXT HAS A LIMIT</span><b>✳</b><span>THE WORK DOESN'T</span><b>✳</b><span>CONTEXT HAS A LIMIT</span><b>✳</b><span>THE WORK DOESN'T</span><b>✳</b></div></div>
    <section id="idea" class="section tension"><div class="wrap"><div class="section-intro"><p class="eyebrow">01 / {c.tensionEyebrow}</p><h2>{c.tensionTitle}</h2><p>{c.tensionText}</p></div><div class="memory-grid">{c.tensionCards.map(([label, title, body], i) => <article class="memory-card"><span class="memory-icon" aria-hidden="true">{['◫', '≡', '✳'][i]}</span><p class="card-label">{label}</p><h3>{title}</h3><p>{body}</p></article>)}</div><div class="principle"><span class="principle-star" aria-hidden="true">✳</span><p>{c.principle}</p><span>{c.principleSub}</span></div></div></section>
    <section id="workflow" class="section workflow"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">02 / {c.flowEyebrow}</p><h2>{c.flowTitle}</h2></div><span class="section-scribble" aria-hidden="true">↘</span></div><div class="flow-grid">{c.flowSteps.map(([number, title, body, token], i) => <article class="flow-card"><div class="flow-top"><span>{number}</span><span class="flow-glyph" aria-hidden="true">{['◉', '↗', '◎', '→'][i]}</span></div><h3>{title}</h3><p>{body}</p><span class="flow-token">{token}</span></article>)}</div><div class="flow-foot"><span>START</span><div class="flow-line"><i></i><i></i><i></i><i></i></div><span>CONTINUE ↗</span></div></div></section>
    <section id="mod" class="section mod-section"><div class="wrap">
      <div class="mod-heading"><p class="eyebrow">03 / {c.modEyebrow}</p><h2>{c.modTitle}</h2><p>{c.modIntro}</p></div>
      <div class="mod-demo" data-mod-demo>
        <div class="mod-tabs" data-tab-label={c.modTitle}>{c.modScenes.map(([label], i) => <button class="mod-tab" type="button" data-mod-tab={i}>{label}</button>)}</div>
        {c.modScenes.map(([label, title, body], i) => <div class="mod-demo-panel" data-mod-panel={i}>
          {i === 0 ? <div class="panel-preview" role="img" aria-label={`${title}: ${body}`}>
            <div class="panel-preview-head"><span class="terminal-lights" aria-hidden="true"><i></i><i></i><i></i></span><span>CLAUDE CODE · /fw-panel</span><span>0.3.0</span></div>
            <div class="panel-preview-body" aria-hidden="true"><div class="panel-preview-chat"><span class="preview-prompt">›</span><div class="preview-chat-line long"></div><div class="preview-chat-line medium"></div><div class="preview-chat-line short"></div><div class="preview-chat-space"></div><div class="preview-chat-line medium"></div><div class="preview-chat-line short"></div><div class="preview-input"><span>›</span><span class="preview-cursor"></span></div></div>
              <div class="panel-preview-pane"><div class="preview-status"><b>✈ flightwake <span class="preview-green">●green</span></b><small>· {c.modPanel.state}</small><div class="preview-context">{c.modPanel.context} <span class="preview-meter"><i></i></span> 42%</div><div class="preview-attention">! {c.modPanel.attention}: {c.modPanel.attentionItem}</div></div><div class="preview-fleet-title">{c.modPanel.fleet}</div><div class="preview-repo"><div class="preview-repo-title">{c.modPanel.repo} <span class="preview-green">●green</span> <small>v0.17.0</small></div><div class="preview-agent"><span class="preview-green">●</span> Codex · {c.modPanel.task} · {c.modPanel.working}<span class="preview-action">[ {c.modPanel.switch} ]</span></div><div class="preview-agent"><span class="preview-green">●</span> Claude · {c.modPanel.current} · {c.modPanel.working}<div class="preview-meter"><i></i></div></div><div class="preview-agent"><span>○</span> Claude · {c.modPanel.idle}<span class="preview-action">[ {c.modPanel.switch} ] [ {c.modPanel.wrap} ]</span></div></div><div class="preview-session">{c.modPanel.session} · /fw-log · /fw-cost</div></div></div>
          </div> : <div class="mod-terminal"><div class="mod-terminal-head"><span class="terminal-lights" aria-hidden="true"><i></i><i></i><i></i></span><span>{`FLIGHTWAKE · FIELD CAPTURE · v${i === 1 ? '0.17.0' : '0.16.0'}`}</span><span>{`0${i + 1} / 04`}</span></div><div class="mod-terminal-command"><span aria-hidden="true">{i === 1 ? '›' : '$'}</span> {modCommands[i - 1]}</div><pre tabindex="0"><code>{modCaptures[i - 1]}</code></pre></div>}
          <div class="mod-panel-copy"><span class="mod-panel-index">{label}</span><h3>{title}</h3><p>{body}</p></div>
        </div>)}
      </div>
      <p class="mod-capture-note">{c.modCaptureNote}</p><div class="mod-links"><a href={`${repo}/blob/main/${modDoc}`} target="_blank" rel="noopener noreferrer">{c.modDocs} ↗</a><a href={`${repo}/releases/tag/v0.17.0`} target="_blank" rel="noopener noreferrer">{c.modRelease} ↗</a></div>
    </div></section>
    <section id="orca" class="section story"><div class="wrap">
      <div class="story-heading"><p class="eyebrow">04 / {c.storyEyebrow}</p><h2>{c.storyTitle}</h2><p>{c.storyIntro}</p></div>
      <div class="story-board"><div class="story-board-head"><span>CASE STUDY · FLIGHTWAKE REPOSITORY</span><span class="story-live"><i></i> 2026.10</span></div><div class="story-columns">{c.storyColumns.map(([label, title, body], i) => <article class="story-column"><div class="story-step"><span>{`0${i + 1}`}</span><span aria-hidden="true">{i === 2 ? '✓' : '↗'}</span></div><p class="story-label">{label}</p><h3>{title}</h3><p>{body}</p></article>)}</div><div class="story-board-bottom"><a href={`${repo}/blob/main/.flightwake/records/261011-fleet-and-setup-flow.md`} target="_blank" rel="noopener noreferrer">{c.storyLink} ↗</a><span>ORCA × FLIGHTWAKE</span></div></div>
      <p class="story-caveat">* {c.storyCaveat}</p>
      <div class="live-case"><div class="live-case-heading"><p class="eyebrow">{c.liveCaseEyebrow}</p><h3>{c.liveCaseTitle}</h3><p>{c.liveCaseIntro}</p></div>
        <div class="live-case-steps">{c.liveCaseSteps.map(([role, title, body], i) => <article class="live-case-step"><span class="live-case-role">{role}</span><span class="live-case-node" aria-hidden="true">{i === 3 ? '◇' : '●'}</span><h4>{title}</h4><p>{body}</p></article>)}</div>
        <p class="live-case-status"><span aria-hidden="true">◌</span> {c.liveCaseStatus}</p>
      </div>
    </div></section>
    <section id="features" class="section features"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">05 / {c.featuresEyebrow}</p><h2>{c.featuresTitle}</h2></div><span class="section-scribble" aria-hidden="true">✳</span></div><div class="feature-list">{c.features.map(([number, title, body]) => <article class="feature-row"><span class="feature-number">{number}</span><h3>{title}</h3><p>{body}</p><span class="feature-arrow" aria-hidden="true">↗</span></article>)}</div></div></section>
    <section id="install" class="section install"><div class="wrap install-grid"><div class="install-copy"><p class="eyebrow">06 / {c.installEyebrow}</p><h2>{c.installTitle}</h2><p>{c.installText}</p><a class="install-doc" href={`${repo}/blob/main/${readme}`} target="_blank" rel="noopener noreferrer">{lang === 'zh-TW' ? '閱讀完整安裝文件' : lang === 'zh-CN' ? '阅读完整安装文档' : lang === 'ja' ? '導入ガイドを読む' : 'Read the full installation guide'} ↗</a></div><div class="install-panel"><div class="code-card"><div class="code-head"><span>01 / {c.installPrimary}</span><button class="copy-button" type="button" data-copy="cd your-repo&#10;npx flightwake setup" data-copied={c.copied} aria-label={`${c.copyButton}: npx flightwake setup`}>{c.copyButton} ↗</button></div><pre tabindex="0"><code><span class="shell-dollar">$</span> cd your-repo
<span class="shell-dollar">$</span> npx flightwake setup</code></pre></div><div class="code-card code-secondary"><div class="code-head"><span>02 / {c.installOther}</span><button class="copy-button" type="button" data-copy={installCommand} data-copied={c.copied} aria-label={`${c.copyButton}: npx flightwake init`}>{c.copyButton} ↗</button></div><pre tabindex="0"><code><span class="shell-dollar">$</span> {installCommand}</code></pre></div><div class="install-note"><span aria-hidden="true">↳</span><p>{c.afterInstall}</p></div><p class="upgrade-note">{c.upgrade}</p></div></div></section>
    <section id="faq" class="section faq"><div class="wrap faq-grid"><div><p class="eyebrow">07 / FAQ</p><h2>{c.faqsTitle}</h2><div class="faq-decoration" aria-hidden="true">?</div></div><div class="faq-list">{c.faqs.map(({ q, a }) => <details><summary>{q}<span aria-hidden="true">＋</span></summary><p>{a}</p></details>)}</div></div></section>
  </main>
  <footer class="site-footer"><div class="wrap"><div class="footer-main"><div><a class="brand footer-brand" href={path}><img class="brand-mark" src="/favicon.svg" width="36" height="36" alt="" /><span>flightwake</span><span class="brand-dot">.</span></a><p>{c.footerLine}</p></div><div class="footer-links"><a href={repo} target="_blank" rel="noopener noreferrer">{c.footerSource} ↗</a><a href="https://www.npmjs.com/package/flightwake" target="_blank" rel="noopener noreferrer">npm ↗</a><a href="#main">{c.footerTop} ↑</a></div></div><div class="footer-bottom"><span>© 2026 FLIGHTWAKE · MIT LICENSE</span><span>RECORDS FOLLOW WORK.</span></div></div></footer>
  <script>
    const demo = document.querySelector<HTMLElement>('[data-mod-demo]');
    if (demo) {
      const tabs = [...demo.querySelectorAll<HTMLButtonElement>('[data-mod-tab]')];
      const panels = [...demo.querySelectorAll<HTMLElement>('[data-mod-panel]')];
      const tabList = demo.querySelector<HTMLElement>('.mod-tabs');
      tabList?.setAttribute('role', 'tablist');
      tabList?.setAttribute('aria-label', tabList.dataset.tabLabel || 'Release demo');
      const select = (index: number, focus = false) => {
        tabs.forEach((tab, i) => {
          tab.setAttribute('aria-selected', String(i === index));
          tab.tabIndex = i === index ? 0 : -1;
          panels[i].hidden = i !== index;
        });
        if (focus) tabs[index].focus();
      };
      tabs.forEach((tab, i) => {
        tab.id = `mod-tab-${i}`;
        tab.setAttribute('role', 'tab');
        tab.setAttribute('aria-controls', `mod-panel-${i}`);
        panels[i].id = `mod-panel-${i}`;
        panels[i].setAttribute('role', 'tabpanel');
        panels[i].setAttribute('aria-labelledby', tab.id);
        tab.addEventListener('click', () => select(i));
        tab.addEventListener('keydown', (event) => {
          const current = tabs.indexOf(document.activeElement as HTMLButtonElement);
          if (current < 0) return;
          let next = current;
          if (event.key === 'ArrowRight') next = (current + 1) % tabs.length;
          else if (event.key === 'ArrowLeft') next = (current + tabs.length - 1) % tabs.length;
          else if (event.key === 'Home') next = 0;
          else if (event.key === 'End') next = tabs.length - 1;
          else return;
          event.preventDefault();
          select(next, true);
        });
      });
      demo.dataset.enhanced = 'true';
      select(0);
    }
    document.querySelectorAll<HTMLButtonElement>('.copy-button').forEach((button) => {
      button.addEventListener('click', async () => {
        const original = button.textContent;
        try {
          await navigator.clipboard.writeText(button.dataset.copy || '');
          button.textContent = button.dataset.copied || 'Copied';
          window.setTimeout(() => { button.textContent = original; }, 1800);
        } catch { button.textContent = original; }
      });
    });
  </script>
</Base>
